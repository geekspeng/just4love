/* filter-panel —— 筛选面板（TDesign 组件承载交互视觉，布局样式自绘；
   颜色直接用主题变量：app.wxss 的工具类不穿透组件 styleIsolation） */
.fp {
  background: #ffffff;
  border-radius: var(--radius-card, 16rpx);
  padding: 0 24rpx;
}
.fp__bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  gap: 12rpx;
}
.fp__bar-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary, #222222);
}
.fp__arrow {
  font-size: 22rpx;
  color: var(--color-text-secondary, #999999);
}
.fp__bar-reset {
  margin-left: auto;
  font-size: 26rpx;
  color: var(--color-primary, #ff5a5f);
}
.fp__body {
  padding: 8rpx 0 24rpx;
}
.fp__group {
  margin-top: 24rpx;
}
.fp__label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary, #999999);
  margin-bottom: 12rpx;
}
.fp__range {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.fp__dash {
  color: var(--color-text-secondary, #999999);
}
.fp__picker {
  min-width: 160rpx;
  padding: 10rpx 24rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-primary, #222222);
  text-align: center;
}
.fp__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.fp__actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
.fp__btn {
  flex: 1;
}
