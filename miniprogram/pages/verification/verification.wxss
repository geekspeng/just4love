.verify__intro {
  font-size: 24rpx;
  margin-bottom: 20rpx;
}
.verify__card {
  margin-bottom: 20rpx;
}
.verify__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.verify__title {
  font-size: 28rpx;
  font-weight: 600;
}
.verify__hint {
  font-size: 24rpx;
  margin-bottom: 12rpx;
}
.verify__shots {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.verify__shot {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}
.verify__shot--add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--color-text-secondary, #999999);
  border: 1rpx dashed #dddddd;
  box-sizing: border-box;
}
