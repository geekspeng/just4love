/* profile-detail —— 详情页（TDesign 承载状态/单元格/按钮；分享为原生 open-type 按钮样式对齐） */
.detail__state {
  padding: 48rpx 0;
}
.detail__privacy {
  margin-top: 20rpx;
}
.detail__actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}
.detail__btn {
  flex: 1;
}
.detail__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}
.detail__share {
  background: #ffffff;
  border: 1rpx solid #e5e5e5;
  color: var(--color-text-primary, #222222);
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 0 40rpx;
  line-height: 64rpx;
  height: 64rpx;
}
.detail__quota {
  text-align: center;
  font-size: 24rpx;
  margin-top: 24rpx;
}
