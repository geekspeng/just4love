<view class="container mine">
  <view class="mine__profile card">
    <image class="mine__avatar" src="{{profile.avatar}}" mode="aspectFill" />
    <view class="mine__info">
      <view class="mine__name">{{profile.nickname}}</view>
      <view class="mine__meta text-secondary">
        <text wx:if="{{profile.age}}">{{profile.age}}</text>
        <text wx:if="{{profile.age && profile.height}}"> · </text>
        <text wx:if="{{profile.height}}">{{profile.height}}</text>
      </view>
    </view>
  </view>

  <view class="mine__menus card">
    <view
      wx:for="{{menus}}"
      wx:key="id"
      class="mine__menu"
      data-id="{{item.id}}"
      bindtap="onTapMenu"
    >
      <text>{{item.label}}</text>
      <text class="mine__arrow text-secondary">›</text>
    </view>
  </view>
</view>
