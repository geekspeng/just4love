.recommend__list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.recommend__filter {
  display: block;
  margin-bottom: 20rpx;
}
.recommend__empty {
  margin-top: 120rpx;
}
.recommend__loading {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
}
.recommend__more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
}
